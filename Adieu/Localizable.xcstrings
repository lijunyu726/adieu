    "通知被关掉了，规则发现情况时没法提醒你。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知被关掉了，规则发现情况时没法提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知被關掉了，規則發現情況時沒辦法提醒你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off, so rules can’t tell you when they find something."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフのため、ルールが何かを見つけても知らせられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있어서, 규칙이 무언가를 찾아도 알려 줄 수 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas, así que las reglas no pueden avisarte cuando encuentren algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées : les règles ne peuvent pas vous prévenir quand elles trouvent quelque chose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind aus, deshalb können dich Regeln nicht benachrichtigen, wenn sie etwas finden."
          }
        }
      }
    },
    "通知还没开，规则发现情况时没法提醒你。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知还没开，规则发现情况时没法提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知還沒開，規則發現情況時沒辦法提醒你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications aren’t on yet, so rules can’t tell you when they find something."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がまだオンでないため、ルールが何かを見つけても知らせられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 아직 켜져 있지 않아서, 규칙이 무언가를 찾아도 알려 줄 수 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones aún no están activadas, así que las reglas no pueden avisarte cuando encuentren algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications ne sont pas encore activées : les règles ne peuvent pas vous prévenir quand elles trouvent quelque chose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind noch nicht an, deshalb können dich Regeln nicht benachrichtigen, wenn sie etwas finden."
