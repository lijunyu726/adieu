          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색인과 캐시"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índices y cachés"
          }
        },
        "fr": {
