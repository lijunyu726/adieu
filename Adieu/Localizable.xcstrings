      }
    },
    "其中有系统级的，系统会要一次开机密码。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中有系统级的，系统会要一次开机密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中有系統級的，系統會要一次開機密碼。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of these are system-wide, so macOS will ask once for the password you use to log in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この中にはシステムレベルのものが含まれ、macOS がログインパスワードを一度尋ねます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그중에는 시스템 수준의 것이 있어서, macOS가 로그인 암호를 한 번 물어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos son de todo el sistema, así que macOS te pedirá una vez la contraseña con la que inicias sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains sont au niveau du système, macOS vous demandera donc une fois le mot de passe de votre session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche davon sind systemweit, macOS fragt deshalb einmal nach dem Passwort, mit dem Du Dich anmeldest."
          }
        }
      }
    },
