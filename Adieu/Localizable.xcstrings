    ") · 只在本机运行，不需要账号": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ") · 只在本机运行，不需要账号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": ") · 只在這部 Mac 上運行，不需要帳號"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ") · Runs only on this Mac, no account needed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ") · この Mac 上だけで動き、アカウントは不要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ") · 이 Mac에서만 실행되며, 계정은 필요 없어요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ") · Solo se ejecuta en este Mac, sin cuenta"
          }
        },
        "fr": {
