    "每天比前一天多用（+）或空出（−）的空间。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天比前一天多用（+）或空出（−）的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天比前一天多用（+）或空出（−）的空間。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space used (+) or freed (−) compared with the day before."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前日より増えた（+）か、空いた（−）容量です。"
