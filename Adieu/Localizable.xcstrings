    "可用 %@，只剩 %lld%%。低于 10%% 时系统会变慢，更新也可能装不上。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用 %@，只剩 %lld%%。低于 10%% 时系统会变慢，更新也可能装不上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用 %@，只剩 %lld%%。低於 10%% 時系統會變慢，更新也可能裝不上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ available, only %lld%% left. Below 10%%, the system slows down, and an update may not install."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空きは %@、残り %lld%% です。10%% を下回るとシステムが遅くなり、アップデートをインストールできないこともあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능 %@, %lld%%만 남았어요. 10%% 아래에서는 시스템이 느려지고, 업데이트가 설치되지 않을 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponibles, solo queda %lld%%. Por debajo del 10%% el sistema se ralentiza y puede que una actualización no se instale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponibles, il ne reste que %lld%%. Sous 10%%, le système ralentit et une mise à jour peut ne pas s'installer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verfügbar, nur noch %lld%%. Unter 10%% wird das System langsamer, und ein Update lässt sich vielleicht nicht installieren."
          }
        }
      }
    },
    "可用 %@，还有 %lld%%。": {
      "localizations": {
        "zh-Hans": {
