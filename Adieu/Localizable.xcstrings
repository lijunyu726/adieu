            "value": "Éléments en arrière-plan d’autres apps"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundobjekte anderer Apps"
          }
        }
      }
    },
    "应用自己装的后台程序。不再用这个应用的话可以移除。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用自己装的后台程序。不再用这个应用的话可以移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式自己裝的背景程式。不再用這個應用程式的話可以移除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background items the app installed itself. If you no longer use the app, you can remove them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ自身が入れたバックグラウンド項目です。そのアプリをもう使わないなら、削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 직접 설치한 백그라운드 항목이에요. 그 앱을 더 쓰지 않으면 제거해도 돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ítems en segundo plano que instaló la propia app. Si ya no usas la app, puedes quitarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éléments en arrière-plan installés par l’app elle-même. Si vous n’utilisez plus l’app, vous pouvez les retirer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundobjekte, die die App selbst installiert hat. Wenn du die App nicht mehr benutzt, kannst du sie entfernen."
          }
        }
      }
    },
    "它要启动的程序已经不存在": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它要启动的程序已经不存在"
          }
        },
        "zh-Hant": {
