    "放进来的文件夹，Adieu 不会碰它和它里面的东西。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放进来的文件夹，Adieu 不会碰它和它里面的东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放進來的檔案夾，Adieu 不會碰它和它裡面的東西。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adieu won't touch a folder you add here, or anything inside it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに追加したフォルダと、その中身には Adieu は触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 넣은 폴더와 그 안의 것은 Adieu가 건드리지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adieu no tocará una carpeta que añadas aquí, ni nada de lo que haya dentro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adieu ne touchera pas à un dossier que vous ajoutez ici, ni à ce qu'il contient."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Ordner, den du hier hinzufügst, und alles darin fasst Adieu nicht an."
          }
        }
      }
    },
