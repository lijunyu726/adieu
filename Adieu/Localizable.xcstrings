    "还在废纸篓里，清空之前随时可以放回": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还在废纸篓里，清空之前随时可以放回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還在廢紙籃裡，清空之前隨時可以放回"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still in the Trash. You can put it back anytime before you empty it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだゴミ箱にあります。空にする前なら、いつでも戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 휴지통에 있어요. 비우기 전에는 언제든 되돌릴 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue en la Papelera. Puedes devolverlo cuando quieras, antes de vaciarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours dans la Corbeille. Vous pouvez le remettre tant qu'elle n'est pas vidée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch im Papierkorb. Du kannst es jederzeit zurücklegen, bevor Du ihn leerst."
          }
        }
      }
    },
    "工具命令直接清理，不经过废纸篓，需要时会重新下载": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具命令直接清理，不经过废纸篓，需要时会重新下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具命令直接清理，不經過廢紙籃，需要時會重新下載"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleaned by the tool's own command. It does not go to the Trash, and downloads again when you need it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールのコマンドで直接片付けました。ゴミ箱は通らず、必要なときに再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 명령이 바로 정리했어요. 휴지통을 거치지 않고, 필요할 때 다시 받아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando de la herramienta lo limpió directamente. No pasa por la Papelera y se vuelve a descargar cuando lo necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyé par la commande de l'outil. Cela ne passe pas par la Corbeille et se retélécharge si vous en avez besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom eigenen Befehl des Tools aufgeräumt. Es geht nicht in den Papierkorb und lädt sich neu herunter, wenn Du es brauchst."
          }
        }
      }
    },
    "废纸篓已经清空，不能再放回": {
