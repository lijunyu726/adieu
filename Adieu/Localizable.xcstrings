    "空间已经腾出来了。以后还想用，重新下载安装就行。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间已经腾出来了。以后还想用，重新下载安装就行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空間已經騰出來了。以後還想用，重新下載安裝就行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The space is free. If you want it again, download and install it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量は戻りました。また使いたくなったら、ダウンロードしてインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간이 비워졌어요. 나중에 다시 쓰려면 받아서 설치하면 돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio ya está libre. Si lo quieres otra vez, descárgalo e instálalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace est libéré. Si vous en avez de nouveau besoin, téléchargez-le et installez-le."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Platz ist frei. Wenn du es wieder nutzen willst, lade es neu herunter und installiere es."
          }
        }
      }
    },
    "上面没删掉的还留在原处。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上面没删掉的还留在原处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上面沒刪掉的還留在原處。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What wasn’t deleted above is still in place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で削除されなかったものは、元の場所に残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에서 지우지 못한 것은 원래 자리에 그대로 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que no se borró arriba sigue en su sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui n’a pas été supprimé ci-dessus est toujours à sa place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was oben nicht gelöscht wurde, liegt noch am alten Ort."
          }
        }
      }
    },
