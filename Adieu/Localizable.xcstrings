          "stringUnit": {
            "state": "translated",
            "value": "C’est un dossier dont le système a besoin. Il ne peut pas être supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Ordner, den das System braucht. Er kann nicht gelöscht werden."
          }
        }
      }
    },
    "不在 Adieu 允许清理的范围内（只处理主目录、应用程序和外置硬盘）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在 Adieu 允许清理的范围内（只处理主目录、应用程序和外置硬盘）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不在 Adieu 允許清理的範圍內（只處理主目錄、應用程式和外接硬碟）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is outside what Adieu is allowed to clean (only your home folder, Applications, and external drives)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Adieu が整理できる範囲外です（ホームフォルダ、アプリケーション、外付けドライブだけを扱います）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Adieu가 정리할 수 있는 범위가 아니에요 (홈 폴더, 응용 프로그램, 외장 드라이브만 다뤄요)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está fuera de lo que Adieu puede limpiar (solo tu carpeta de inicio, Aplicaciones y discos externos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En dehors de ce qu’Adieu peut nettoyer (uniquement votre dossier de départ, Applications et les disques externes)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außerhalb dessen, was Adieu aufräumen darf (nur dein Benutzerordner, Programme und externe Festplatten)."
          }
        }
      }
    },
    "没有输入管理员密码，留在原处": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有输入管理员密码，留在原处"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有輸入管理者密碼，留在原處"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You didn’t enter the administrator password, so it stayed where it was."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者パスワードが入力されなかったため、元の場所に残しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
