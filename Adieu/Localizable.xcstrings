          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "穩妥的部分加起來只有 %@，還需要 %lld 項要你確認的內容，理由都寫在旁邊了。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The safe part only comes to %@. You still need to confirm %lld items. The reasons are written beside them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な部分を合わせても %@ だけです。確認してほしいものが %lld 件あります。理由は横に書いてあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 부분을 합쳐도 %@뿐이에요. 확인할 항목이 %lld개 더 있어요. 이유는 옆에 적어 두었어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo seguro suma solo %@. Aún tienes que confirmar %lld elementos. Las razones están escritas al lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partie sûre ne fait que %@. Il vous reste %lld éléments à confirmer. Les raisons sont écrites à côté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
