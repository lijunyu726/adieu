    "一周前还不在最大的 30 个应用里，可能是新装的。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一周前还不在最大的 30 个应用里，可能是新装的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一週前還不在最大的 30 個應用程式裡，可能是新裝的。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It wasn’t among the 30 largest apps a week ago. It may be newly installed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1週間前は大きい順の上位30個に入っていませんでした。新しく入れたのかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일주일 전에는 가장 큰 앱 30개 안에 없었어요. 새로 설치한 것일 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace una semana no estaba entre las 30 apps más grandes. Puede que la acabes de instalar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a une semaine, elle ne figurait pas parmi les 30 apps les plus volumineuses. Vous venez peut-être de l’installer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor einer Woche war sie nicht unter den 30 größten Apps. Vielleicht hast du sie neu installiert."
          }
        }
      }
    },
    "应用和它的数据一共长大了这么多。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用和它的数据一共长大了这么多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式和它的資料一共長大了這麼多。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app and its data grew by this much, together."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリとそのデータが、合わせてこれだけ増えました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱과 데이터가 합해서 이만큼 커졌어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app y sus datos crecieron juntos en esta cantidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
