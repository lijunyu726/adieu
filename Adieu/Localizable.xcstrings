{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "资源库里的数据都能对上已装的应用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源库里的数据都能对上已装的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資源庫裡的資料都能對上已安裝的應用程式。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in Library matches an installed app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ内のデータは、すべてインストール済みのアプリと一致しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리의 데이터는 모두 설치된 앱과 일치해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo de la Biblioteca corresponde a una app instalada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui se trouve dans la bibliothèque correspond à une app installée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in der Library gehört zu einer installierten App."
          }
        }
      }
    },
    "正在对照已装应用查找残留…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在对照已装应用查找残留…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在對照已安裝的應用程式尋找殘留…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matching installed apps to find leftovers…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのアプリと照合して、残留ファイルを探しています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 앱과 대조해 남은 파일을 찾고 있어요…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparando con las apps instaladas para buscar restos…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparaison avec les apps installées pour trouver des restes…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Resten anhand der installierten Apps…"
          }
        }
      }
    },
    "没有找到残留": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到残留"
          }
