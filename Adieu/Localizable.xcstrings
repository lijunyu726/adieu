    "没有要删的。保留 %lld 个 · 留到下次 %lld 个": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有要删的。保留 %lld 个 · 留到下次 %lld 个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有要刪的。保留 %lld 個 · 留到下次 %lld 個"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to delete. Kept %lld · Next time %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するものはありません。残す %lld 件 · 次回 %lld 件"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제할 것이 없어요. 유지 %lld개 · 다음에 %lld개"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que eliminar. Conservados %lld · Para la próxima %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à supprimer. Gardés %lld · Pour la prochaine fois %lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu löschen. Behalten %lld · Beim nächsten Mal %lld"
          }
        }
      }
    },
