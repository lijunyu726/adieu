    "这是 App Store 应用，卸载后可以在 App Store 免费重新下载。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 App Store 应用，卸载后可以在 App Store 免费重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是 App Store 應用程式，解除安裝後可以在 App Store 免費重新下載。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an App Store app. After you uninstall it, you can download it again for free from the App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは App Store のアプリです。アンインストールしたあと、App Store から無料で再ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 앱이에요. 제거한 뒤 App Store에서 무료로 다시 받을 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una app del App Store. Después de desinstalarla, puedes volver a descargarla gratis en el App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une app de l’App Store. Après la désinstallation, vous pouvez la retélécharger gratuitement depuis l’App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine App aus dem App Store. Nach dem Deinstallieren kannst du sie im App Store kostenlos erneut laden."
          }
        }
      }
    },
