    "将直接删除 %@，不进废纸篓，删了不能放回。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将直接删除 %@，不进废纸篓，删了不能放回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將直接刪除 %@，不進廢紙籃，刪了不能放回。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be deleted for good. It does not go to the Trash, and you can't put it back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を完全に削除します。ゴミ箱には入らず、戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 완전히 삭제해요. 휴지통으로 가지 않고, 되돌릴 수 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se eliminará para siempre. No va a la Papelera y no podrás devolverlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera supprimé définitivement. Cela ne va pas dans la Corbeille, et vous ne pourrez pas le remettre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird endgültig gelöscht. Es geht nicht in den Papierkorb, und Du kannst es nicht zurücklegen."
          }
        }
      }
    },
