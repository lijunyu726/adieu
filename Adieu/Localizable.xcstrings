    "共 %@。装好以后一般就用不上了，需要时再下载。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %@。装好以后一般就用不上了，需要时再下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %@。裝好以後一般就用不上了，需要時再下載。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in total. After they’re installed, you usually don’t need them. Download again if you do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計 %@。インストールしたあとは、たいてい不要です。必要なら、またダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "합계 %@. 설치한 뒤에는 보통 필요 없어요. 필요하면 다시 받으면 돼요."
          }
        },
        "es": {
