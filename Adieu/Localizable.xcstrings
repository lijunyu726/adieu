    "%@ 归系统管理员所有（App Store 装的应用常这样），点“卸载”后系统会请你输入一次开机密码。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 归系统管理员所有（App Store 装的应用常这样），点“卸载”后系统会请你输入一次开机密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 歸系統管理員所有（App Store 裝的應用程式常這樣），點「解除安裝」後系統會請你輸入一次登入密碼。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is owned by the system administrator (common for apps from the App Store). After you click Uninstall, macOS asks once for your login password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はシステム管理者の所有です（App Store のアプリによくあります）。「アンインストール」を押すと、ログインパスワードの入力を一度求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 시스템 관리자 소유예요(App Store에서 설치한 앱이 자주 그래요). ‘제거’를 누르면 로그인 암호를 한 번 물어봐요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pertenece al administrador del sistema (suele pasar con las apps del App Store). Al pulsar Desinstalar, el sistema te pide una vez la contraseña con la que inicias sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appartient à l’administrateur système (fréquent pour les apps de l’App Store). Après un clic sur Désinstaller, le système vous demande une fois le mot de passe de session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehört dem Systemadministrator (häufig bei Apps aus dem App Store). Nach „Deinstallieren“ fragt das System einmal nach deinem Anmeldepasswort."
          }
        }
      }
    },
