            "state": "translated",
            "value": "ダウンロードした依存関係です。次のインストールで再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내려받은 의존성이에요. 다음에 설치할 때 다시 받아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependencias descargadas. Se vuelven a descargar la próxima vez que instales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépendances téléchargées. Elles se retéléchargent à la prochaine installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladene Abhängigkeiten. Beim nächsten Installieren werden sie neu geladen."
          }
        }
      }
    },
