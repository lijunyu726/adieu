        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷이에요. 다 썼으면 지워도 돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una captura de pantalla. Cuando termines con ella, puedes borrarla."
          }
